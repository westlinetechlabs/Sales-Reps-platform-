generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SALES_REP") // OWNER | SALES_REP
  phone     String?
  region    String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers  Customer[]
  deals      Deal[]
  activities Activity[]
  notes      Note[]
  targets    Target[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  city      String?
  status    String   @default("LEAD") // LEAD | PROSPECT | CUSTOMER | INACTIVE
  value     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repId      String
  rep        User       @relation(fields: [repId], references: [id], onDelete: Cascade)
  deals      Deal[]
  activities Activity[]
  notes      Note[]
}

model Deal {
  id          String    @id @default(cuid())
  title       String
  value       Float     @default(0)
  stage       String    @default("PROSPECTING") // PROSPECTING | QUALIFICATION | PROPOSAL | NEGOTIATION | CLOSED_WON | CLOSED_LOST
  probability Int       @default(10)
  closeDate   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  repId      String
  rep        User      @relation(fields: [repId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model Activity {
  id          String   @id @default(cuid())
  type        String   // CALL | MEETING | EMAIL | DEMO | VISIT
  title       String
  description String?
  date        DateTime @default(now())
  duration    Int?     // minutes
  outcome     String?
  createdAt   DateTime @default(now())

  repId      String
  rep        User      @relation(fields: [repId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repId      String
  rep        User      @relation(fields: [repId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model Target {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  revenue   Float    @default(0)
  deals     Int      @default(0)
  calls     Int      @default(0)
  meetings  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repId String
  rep   User   @relation(fields: [repId], references: [id], onDelete: Cascade)

  @@unique([repId, month, year])
}
